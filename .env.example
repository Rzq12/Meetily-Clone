# Copy to .env and fill in real values. Never commit .env.

POSTGRES_DB=notulensi
POSTGRES_USER=notulensi
POSTGRES_PASSWORD=change-me

# For `go run ./cmd/server` on the host; the app container builds its own URL.
DATABASE_URL=postgres://notulensi:change-me@localhost:5432/notulensi?sslmode=disable
DATA_DIR=./data
WHISPER_URL=http://localhost:8081

# OpenAI-compatible endpoint. Ollama by default; a cloud endpoint sends transcripts outside the company.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b
LLM_API_KEY=
LLM_TOKEN_THRESHOLD=6000

AUDIO_RETENTION_DAYS=90

# First Admin account, created only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

TZ=Asia/Jakarta

# Hostname Caddy serves, e.g. notulensi.kantor.local
SITE_ADDRESS=notulensi.kantor.local
